{
  "name": "orqland-chat-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @orqland/contracts build && pnpm --filter @orqland/api build && pnpm --filter @orqland/web build",
    "build:backend": "pnpm --filter @orqland/api build",
    "build:frontend": "pnpm --filter @orqland/web build",
    "dev": "pnpm --parallel --filter @orqland/api --filter @orqland/web dev",
    "dev:backend": "pnpm --filter @orqland/api start:dev",
    "dev:frontend": "pnpm --filter @orqland/web dev",
    "dev:web": "pnpm --filter @orqland/web dev",
    "dev:api": "pnpm --filter @orqland/api start:dev",
    "test": "pnpm --filter @orqland/api test",
    "test:backend": "pnpm --filter @orqland/api test",
    "test:e2e": "pnpm --filter @orqland/api test:e2e",
    "lint": "pnpm --recursive run lint",
    "db:generate": "pnpm --filter @orqland/api db:generate",
    "db:migrate": "pnpm --filter @orqland/api db:migrate",
    "db:seed": "pnpm --filter @orqland/api db:seed"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs",
      "@apollo/protobufjs",
      "@nestjs/core"
    ]
  }
}
