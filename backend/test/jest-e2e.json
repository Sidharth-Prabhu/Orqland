{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": "<rootDir>/cjs-transformer.js"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!.*(?:@nestjs[+/](?:graphql|apollo|mapped-types)|@apollo[+/]|@as-integrations[+/]|@graphql-tools[+/]))"
  ],
  "testEnvironment": "node"
}
