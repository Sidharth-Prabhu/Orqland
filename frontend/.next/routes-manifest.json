{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/chat/conversations/[id]",
      "regex": "^/api/chat/conversations/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/chat/conversations/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/chat/conversations/[id]/end",
      "regex": "^/api/chat/conversations/([^/]+?)/end(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/chat/conversations/(?<nxtPid>[^/]+?)/end(?:/)?$"
    },
    {
      "page": "/api/chat/conversations/[id]/read",
      "regex": "^/api/chat/conversations/([^/]+?)/read(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/chat/conversations/(?<nxtPid>[^/]+?)/read(?:/)?$"
    },
    {
      "page": "/api/chat/conversations/[id]/reopen",
