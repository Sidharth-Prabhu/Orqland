rules_version = '2';

// Craft rules based on data in your Firestore or Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    match /chat_attachments/{conversationId}/{allPaths=**} {
      // Allow read access for authenticated users
      allow read: if request.auth != null;

      // Allow upload if authenticated, file is <= 5MB, and not executable
      allow write: if request.auth != null 
                   && request.resource.size <= 5 * 1024 * 1024;

      // Allow deletion (e.g. client/server auto-cleanup after 48-hour retention)
      allow delete: if request.auth != null;
    }
  }
}
